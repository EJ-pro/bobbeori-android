# Local fixture mode: never enable this in production.
EXTRACTION_FIXTURE_MODE=false

# Production transcript provider contract:
# POST JSON: { "videoId": "...", "url": "...", "language": "ko" }
# Response JSON: { "transcript": "..." }
TRANSCRIPT_PROVIDER_URL=
TRANSCRIPT_PROVIDER_KEY=

# Server-side only. Never put this key in the Android app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
